<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>transponder-parent</artifactId>
    <groupId>org.orienteer.transponder</groupId>
    <version>1.1-SNAPSHOT</version>
  </parent>

  <artifactId>transponder-orientdb</artifactId>

  <name>transponder-orientdb</name>

  <dependencies>
  	<dependency>
      <groupId>org.orienteer.transponder</groupId>
      <artifactId>transponder-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.orienteer.transponder</groupId>
      <artifactId>transponder-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
	  <scope>test</scope>
    </dependency>
    <dependency>
		<groupId>com.orientechnologies</groupId>
		<artifactId>orientdb-core</artifactId>
		<version>${orientdb.version}</version>
		<scope>provided</scope>
		<!-- OrientDB 3.2.x brings GraalVM/Truffle 21.3.5, which fails on JDK 22+ (it calls the removed
		     sun.misc.Unsafe.ensureClassInitialized). Replaced by the current GraalJS below, in test scope only:
		     orientdb-core is provided, so the consumer (Orienteer) brings OrientDB and its script engine (REFRESH_PLAN.md D4). -->
		<exclusions>
			<exclusion>
				<groupId>org.graalvm.sdk</groupId>
				<artifactId>*</artifactId>
			</exclusion>
			<exclusion>
				<groupId>org.graalvm.truffle</groupId>
				<artifactId>*</artifactId>
			</exclusion>
			<exclusion>
				<groupId>org.graalvm.js</groupId>
				<artifactId>*</artifactId>
			</exclusion>
			<exclusion>
				<groupId>org.graalvm.tools</groupId>
				<artifactId>*</artifactId>
			</exclusion>
		</exclusions>
	</dependency>
	<!-- GraalJS for the embedded OrientDB in tests (same artifacts as wicket-orientdb, which Orienteer gets it from) -->
	<dependency>
		<groupId>org.graalvm.polyglot</groupId>
		<artifactId>polyglot</artifactId>
		<version>${graalvm.version}</version>
		<scope>test</scope>
	</dependency>
	<dependency>
		<groupId>org.graalvm.js</groupId>
		<artifactId>js-scriptengine</artifactId>
		<version>${graalvm.version}</version>
		<scope>test</scope>
	</dependency>
	<dependency>
		<groupId>org.graalvm.js</groupId>
		<artifactId>js</artifactId>
		<version>${graalvm.version}</version>
		<type>pom</type>
		<scope>test</scope>
	</dependency>
  </dependencies>
</project>
